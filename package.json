{
  "name": "open-livecam-atlas",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A privacy-conscious atlas of officially published public live cameras.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:metadata": "node scripts/write-build-info.mjs",
    "sync:sources": "node scripts/sync-cameras.mjs",
    "sync:check": "node scripts/validate-catalog.mjs public/data/cameras.json",
    "verify:public": "node scripts/verify-public.mjs",
    "check": "npm run sync:check && npm test && npm run build"
  },
  "dependencies": {
    "hls.js": "^1.7.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
